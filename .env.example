# Connection to a PostgreSQL server with wal_level = logical. DATABASE_URL works too.
CDC_DSN=postgresql://postgres:postgres@localhost:5432/postgres
CDC_SLOT=cdc_relay
CDC_PUBLICATION=cdc_relay
# Optional YAML config with routing rules (see examples/relay.yaml)
CDC_CONFIG=examples/relay.yaml
# Sink: stdout | file | webhook | redis
CDC_SINK=stdout
CDC_WEBHOOK_URL=
CDC_WEBHOOK_SECRET=
CDC_REDIS_URL=redis://localhost:6379/0
CDC_SINK_PATH=records.jsonl
# Secret for HMAC masking of mask_columns
CDC_MASK_SALT=
CDC_CHECKPOINT_PATH=relay.checkpoint.json
CDC_DEAD_LETTER_PATH=deadletter.jsonl
# 0 disables the status server
CDC_STATUS_PORT=8086
CDC_LOG_LEVEL=INFO
